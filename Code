pragma solidity ^0.8.20;

// Integrating industry-standard OpenZeppelin libraries for advanced security
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/Pausable.sol";

// Importing the VRF Consumer Base and Coordinator Interfaces
import "@chainlink/contracts/src/v0.8/vrf/VRFConsumerBaseV2.sol";
import "@chainlink/contracts/src/v0.8/interfaces/VRFCoordinatorV2Interface.sol";

/**
 * @title ZilliqaEVMCasino
 * @dev High-level decentralized casino contract compatible with Zilliqa EVM.
 * Implements ReentrancyGuard, Pausable, and a Pull-over-Push withdrawal pattern for maximum security.
 */
contract ZilliqaEVMCasino is VRFConsumerBaseV2, Ownable, ReentrancyGuard, Pausable {
    
    // --- State Variables ---
    VRFCoordinatorV2Interface private immutable i_vrfCoordinator;
    bytes32 private immutable i_gasLane;
    uint64 private immutable i_subscriptionId;
    uint32 private constant CALLBACK_GAS_LIMIT = 200000;
    uint16 private constant REQUEST_CONFIRMATIONS = 3;
    uint32 private constant NUM_WORDS = 1;

    // Supported game types
    enum GameType { COIN_FLIP, DICE_ROLL }

    // Struct to hold session data for each betting instance
    struct GameSession {
        address player;
        uint256 wagerAmount;
        GameType game;
        uint256 choice; // 0 or 1 for Coin Flip; 1-99 for Dice
        bool isResolved;
    }

    // --- Mappings ---
    // Maps a Chainlink VRF request ID to a specific game session
    mapping(uint256 => GameSession) public s_requests; 
    
    // Maps player addresses to their available withdrawable balances (Pull Pattern)
    mapping(address => uint256) public s_playerBalances; 

    // --- Events ---
    // Emitted when a user successfully places a bet and calls the Oracle
    event GameStarted(uint256 indexed requestId, address indexed player, GameType game, uint256 wager);
    // Emitted when the Oracle returns the random number and settles the bet
    event GameResolved(uint256 indexed requestId, address indexed player, bool won, uint256 payout);
    event FundsDeposited(address indexed player, uint256 amount);
    event FundsWithdrawn(address indexed player, uint256 amount);

    /**
     * @dev Constructor initializes the VRF Coordinator and sets the contract owner.
     * @param vrfCoordinatorV2 Address of the VRF Coordinator (e.g., your deployed Mock on Zilliqa EVM)
     * @param gasLane The key hash representing the maximum gas price
     * @param subscriptionId The VRF subscription ID
     */
    constructor(
        address vrfCoordinatorV2,
        bytes32 gasLane,
        uint64 subscriptionId
    ) VRFConsumerBaseV2(vrfCoordinatorV2) Ownable(msg.sender) {
        i_vrfCoordinator = VRFCoordinatorV2Interface(vrfCoordinatorV2);
        i_gasLane = gasLane;
        i_subscriptionId = subscriptionId;
    }

    /**
     * @notice Allows players to deposit funds (e.g., ZIL) into their internal account before playing.
     * @dev Reverts if the contract is paused or if the deposit is 0.
     */
    function deposit() external payable whenNotPaused {
        require(msg.value > 0, "Deposit amount must be greater than 0");
        s_playerBalances[msg.sender] += msg.value;
        emit FundsDeposited(msg.sender, msg.value);
    }

    /**
     * @notice Initiates a Coin Flip game.
     * @param choice 0 for Heads, 1 for Tails.
     * @param wager The amount to bet in Wei.
     */
    function playCoinFlip(uint256 choice, uint256 wager) external whenNotPaused nonReentrant {
        require(choice == 0 || choice == 1, "Choice must be 0 or 1");
        _startGame(GameType.COIN_FLIP, choice, wager);
    }

    /**
     * @notice Initiates a Dice Roll game (Under game).
     * @param choice The number the player bets the dice will roll under (1-99).
     * @param wager The amount to bet in Wei.
     */
    function playDice(uint256 choice, uint256 wager) external whenNotPaused nonReentrant {
        require(choice > 0 && choice < 100, "Invalid dice choice");
        _startGame(GameType.DICE_ROLL, choice, wager);
    }

    /**
     * @dev Internal function to handle the logic of locking the wager and requesting a random number.
     * @param game The type of game being played.
     * @param choice The player's prediction.
     * @param wager The bet amount.
     */
    function _startGame(GameType game, uint256 choice, uint256 wager) internal {
        require(s_playerBalances[msg.sender] >= wager, "Insufficient internal balance, please deposit");
        
        // Ensure the house has enough liquidity to pay out a potential win
        require(address(this).balance >= wager * 2, "Insufficient house liquidity");

        // Lock the player's wager
        s_playerBalances[msg.sender] -= wager;

        // Request a random number from the VRF Coordinator
        uint256 requestId = i_vrfCoordinator.requestRandomWords(
            i_gasLane,
            i_subscriptionId,
            REQUEST_CONFIRMATIONS,
            CALLBACK_GAS_LIMIT,
            NUM_WORDS
        );

        // Store the session details
        s_requests[requestId] = GameSession({
            player: msg.sender,
            wagerAmount: wager,
            game: game,
            choice: choice,
            isResolved: false
        });

        emit GameStarted(requestId, msg.sender, game, wager);
    }

    /**
     * @dev Callback function called by the VRF Coordinator when the random number is ready.
     * @param requestId The ID of the original request.
     * @param randomWords The array of random numbers provided by the Oracle.
     */
    function fulfillRandomWords(uint256 requestId, uint256[] memory randomWords) internal override {
        GameSession storage session = s_requests[requestId];
        require(session.wagerAmount > 0, "Session not found");
        require(!session.isResolved, "Session already resolved");

        session.isResolved = true;
        uint256 rng = randomWords[0];
        bool won = false;
        uint256 payout = 0;

        // Logic for evaluating the game outcome based on the pseudo-random number
        if (session.game == GameType.COIN_FLIP) {
            uint256 coinResult = rng % 2; // Result is 0 or 1
            if (coinResult == session.choice) {
                won = true;
                payout = session.wagerAmount * 2; // 2x multiplier
            }
        } else if (session.game == GameType.DICE_ROLL) {
            uint256 diceResult = (rng % 100) + 1; // Result is 1 to 100
            if (diceResult < session.choice) { // Player wins if dice result is less than their choice
                won = true;
                payout = session.wagerAmount * 2; // Static 2x multiplier for simplicity
            }
        }

        if (won) {
            // Add the winnings to the player's internal balance (Pull Pattern)
            // We DO NOT transfer funds directly here to prevent Reentrancy and out-of-gas errors
            s_playerBalances[session.player] += payout;
        }

        emit GameResolved(requestId, session.player, won, payout);
    }

    /**
     * @notice Allows players to withdraw their available internal balance.
     * @param amount The amount of Wei to withdraw.
     */
    function withdrawPlayerBalance(uint256 amount) external nonReentrant {
        require(s_playerBalances[msg.sender] >= amount, "Insufficient balance");
        
        // State update MUST happen before the external transfer (Checks-Effects-Interactions pattern)
        s_playerBalances[msg.sender] -= amount;
        
        (bool success, ) = payable(msg.sender).call{value: amount}("");
        require(success, "Transfer failed");
        
        emit FundsWithdrawn(msg.sender, amount);
    }

    // --- Admin / House Functions ---

    /**
     * @notice Allows the owner to deposit funds to act as the house bankroll (liquidity).
     */
    function depositBankroll() external payable onlyOwner {}

    /**
     * @notice Allows the owner to withdraw funds from the house bankroll.
     * @param amount The amount to withdraw.
     */
    function withdrawBankroll(uint256 amount) external onlyOwner {
        require(address(this).balance >= amount, "Insufficient house liquidity");
        (bool success, ) = payable(owner()).call{value: amount}("");
        require(success, "Bankroll transfer failed");
    }

    /**
     * @notice Pauses all betting activities in case of emergencies or maintenance. 
     * Can only be called by the owner.
     */
    function pauseContract() external onlyOwner {
        _pause();
    }

    /**
     * @notice Resumes all betting activities. Can only be called by the owner.
     */
    function unpauseContract() external onlyOwner {
        _unpause();
    }
}

